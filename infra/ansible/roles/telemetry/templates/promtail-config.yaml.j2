server:
  http_listen_port: 9080
  grpc_listen_port: 0

positions:
  filename: /tmp/positions.yaml

clients:
  - url: "{{ loki_url }}/loki/api/v1/push"
    basic_auth:
      username: "{{ loki_user_id }}"
      password: "{{ loki_api_token }}"

scrape_configs:
  - job_name: system_logs
    static_configs:
      - targets: [localhost]
        labels:
          job: varlogs
          host: "{{ inventory_hostname }}"
          __path__: /var/log/*.log

  - job_name: app_logs
    static_configs:
      - targets: [localhost]
        labels:
          job: portfolio-backend
          host: "{{ inventory_hostname }}"
          __path__: /home/deploy/.pm2/logs/*.log