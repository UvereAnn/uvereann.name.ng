# vars.yml.example — Template showing required variables
# Copy to vars.yml and fill in real values
# Never commit vars.yml

domain_name: "uvereann.name.ng"
certbot_email: "your@email.com"
repo_url: "https://github.com/YOUR_USERNAME/uvereann.name.ng.git"
app_dir: "/srv/portfolio"
node_env: "production"
port: "3000"
allowed_origin: "https://uvereann.name.ng"
db_path: "/srv/portfolio/backend/database.db"
resend_api_key: "re_your_key_here"
notify_email: "your@email.com"
admin_secret: "your_long_random_secret"
loki_url: "https://logs-prod-xxx.grafana.net"   # Replace with your Grafana Loki URL
loki_user_id: "your_user_id"                    # Replace with your Grafana User ID
loki_api_token: "your_cloud_access_token"       # Replace with your Grafana Access Policy Token