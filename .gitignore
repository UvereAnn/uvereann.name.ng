.terraform.tfstate.lock.info

# Terraform working directory — downloaded provider plugins
.terraform/
.terraform.lock.hcl

# Your actual secret values — treat like .env
terraform.tfvars

# Crash logs
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json
